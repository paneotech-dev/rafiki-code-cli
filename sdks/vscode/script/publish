#!/usr/bin/env bash
# Publishes an already built Rafiki Code .vsix to the Microsoft Marketplace
# and to Open VSX, with the tools pinned in package.json. Run by a person
# from sdks/vscode, never by CI (docs/release-vscode.md).
#
# Usage: VSCE_PAT=... OVSX_PAT=... script/publish dist/rafiki-code-<version>.vsix
set -euo pipefail

vsix="${1:-}"
if [ -z "$vsix" ] || [ ! -f "$vsix" ]; then
  echo "Usage: script/publish <path to .vsix>" >&2
  exit 2
fi
if [ -z "${VSCE_PAT:-}" ] || [ -z "${OVSX_PAT:-}" ]; then
  echo "Set VSCE_PAT (Microsoft Marketplace) and OVSX_PAT (Open VSX) first." >&2
  exit 2
fi

./node_modules/.bin/vsce publish --packagePath "$vsix"
./node_modules/.bin/ovsx publish "$vsix"
