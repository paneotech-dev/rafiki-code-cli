#!/usr/bin/env bash
# Creates the tag that makes CI build the .vsix (.github/workflows/rafiki-vscode.yml)
# for the version in package.json, and pushes that one tag only.
# Run by a person after the version bump is merged (docs/release-vscode.md).
set -euo pipefail

version="$(node -p "require('./package.json').version")"
tag="rafiki-vscode-v${version}"
if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
  echo "Tag ${tag} already exists." >&2
  exit 1
fi
git tag -a "${tag}" -m "Rafiki Code for VS Code ${version}"
git push origin "refs/tags/${tag}"
