{
  "name": "rafiki-code",
  "displayName": "Rafiki Code",
  "description": "Rafiki Code in VS Code: the rafikicode coding agent in an editor terminal, signed in with your Rafiki AI account.",
  "version": "0.1.0",
  "publisher": "paneotech",
  "author": "PANEOTECH",
  "repository": {
    "type": "git",
    "url": "https://github.com/paneotech-dev/rafiki-code-cli"
  },
  "bugs": {
    "url": "https://github.com/paneotech-dev/rafiki-code-cli/issues"
  },
  "homepage": "https://github.com/paneotech-dev/rafiki-code-cli/blob/v0.1.4/docs/ide.md",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#241040",
    "theme": "dark"
  },
  "keywords": [
    "rafiki",
    "rafikicode",
    "ai",
    "coding agent",
    "terminal"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rafikicode.open",
        "title": "Open",
        "category": "Rafiki Code",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "rafikicode.openNew",
        "title": "Open in New Tab",
        "category": "Rafiki Code",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "rafikicode.sendSelection",
        "title": "Send Selection or File",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.sendFile",
        "title": "Send File",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.signIn",
        "title": "Sign In",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.signOut",
        "title": "Sign Out",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.showAccount",
        "title": "Show Account",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.doctor",
        "title": "Doctor",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.pickTier",
        "title": "Choose Tier",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.refreshStatus",
        "title": "Refresh Status",
        "category": "Rafiki Code"
      },
      {
        "command": "rafikicode.statusMenu",
        "title": "Show Menu",
        "category": "Rafiki Code"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rafikicode.openNew",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "rafikicode.sendSelection",
          "group": "rafikicode@1"
        }
      ],
      "explorer/context": [
        {
          "command": "rafikicode.sendFile",
          "when": "!explorerResourceIsFolder",
          "group": "rafikicode@1"
        }
      ],
      "commandPalette": [
        {
          "command": "rafikicode.sendFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rafikicode.open",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "rafikicode.openNew",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "rafikicode.sendSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "Rafiki Code",
      "properties": {
        "rafikicode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path of the `rafikicode` command. Empty: search `PATH`, then `~/.rafikicode/bin` (the installer's default), then common install directories."
        },
        "rafikicode.tier": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "fast",
            "pro",
            "max"
          ],
          "enumDescriptions": [
            "The model from your rafikicode configuration (rafiki-fast unless you changed it).",
            "rafiki-fast: everyday coding at the lowest credit cost (1x).",
            "rafiki-pro: long agentic tasks (4x credits).",
            "rafiki-max: frontier models (15x credits)."
          ],
          "markdownDescription": "Tier for new Rafiki Code sessions. Change it with **Rafiki Code: Choose Tier**; a running session keeps its model."
        },
        "rafikicode.terminalLocation": {
          "type": "string",
          "default": "editor",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Open Rafiki Code in an editor tab beside the current file.",
            "Open Rafiki Code in the terminal panel."
          ],
          "description": "Where Rafiki Code sessions open."
        },
        "rafikicode.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Rafiki Code key state and tier in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && node --test \"out/test/unit/*.test.js\"",
    "vsix": "vsce package --no-dependencies -o dist/rafiki-code.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "ovsx": "1.1.1",
    "typescript": "^5.8.3"
  }
}
